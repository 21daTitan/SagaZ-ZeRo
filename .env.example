# Optional and never committed. Copy to .env manually; it is not autoloaded.
# DSANT_BASE_URL=http://127.0.0.1:11434/v1
# DSANT_MODEL=your-existing-model
# DSANT_API_KEY=
# SAGAZ_API_TOKEN=long-random-secret-for-local-api-clients
# SAGAZ_AUDIT_KEY=long-random-key-for-checkpoint-signature
# SAGAZ_BUDGET_USD=1.00
# SAGAZ_INPUT_USD_PER_M=0.00
# SAGAZ_OUTPUT_USD_PER_M=0.00
# SAGA_PIX_KEY=your-real-pix-key (optional; no default)
# SAGAZ_GUARD_ENABLED=0
# Docker only (exposed on HOST 127.0.0.1):
# SAGAZ_BIND_ALL=1
