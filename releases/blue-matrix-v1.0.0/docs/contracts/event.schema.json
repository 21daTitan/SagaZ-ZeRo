{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagaz.21apvs.tech/schemas/event.v1.json",
  "title": "dSant ecosystem integration event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "trace_id", "issuer", "target", "action", "approval", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 8},
    "trace_id": {"type": "string", "minLength": 8},
    "issuer": {"type": "string"},
    "target": {"type": "string", "enum": ["sagaz", "dsant-creator", "tool", "agent"]},
    "action": {"type": "string", "minLength": 1},
    "approval": {"type": "string", "enum": ["not-required", "pending", "approved", "denied"]},
    "payload": {"type": "object"}
  }
}
