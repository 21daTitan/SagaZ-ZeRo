[Unit]
Description=SagaZ ZeRo / HooLeeSheet (local-only)
After=network.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/SagaZ-ZeRo
ExecStart=/usr/bin/python3 -m sagaz --web --port 8080
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
